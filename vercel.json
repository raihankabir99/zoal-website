{
  "version": 2,
  "functions": {
    "api/server.ts": {
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "src": "/api/admin/dashboard-analytics",
      "dest": "/api/admin/dashboard-analytics.ts"
    },
    {
      "src": "/api/categories",
      "dest": "/api/categories.ts"
    },
    {
      "src": "/api/inventory",
      "dest": "/api/inventory.ts"
    },
    {
      "src": "/api/support",
      "dest": "/api/support.ts"
    },
    {
      "src": "/api/support/(.*)",
      "dest": "/api/support.ts"
    },
    {
      "src": "/api/cms",
      "dest": "/api/cms.ts"
    },
    {
      "src": "/api/cms/(.*)",
      "dest": "/api/cms.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/server.ts"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/server.ts"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/server.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/server.ts"
    }
  ]
}